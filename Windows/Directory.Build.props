<Project><PropertyGroup><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><PathMap>$(MSBuildThisFileDirectory)=/_/Windows/</PathMap><CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory><Deterministic>true</Deterministic></PropertyGroup></Project>
